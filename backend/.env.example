# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection settings
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=loss_calculator

# ============================================
# AUTHENTICATION
# ============================================
# JWT Secret - used to sign authentication tokens
# Generate a random string: https://www.grc.com/passwords.htm
JWT_SECRET=your_secret_key_here_at_least_32_characters

# ============================================
# SERVER
# ============================================
# Port the server will run on
PORT=3000